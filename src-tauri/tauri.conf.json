{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DumbManager Rust",
  "mainBinaryName": "dumbmanager-rust",
  "version": "0.1.0",
  "identifier": "io.dumbmanager.rust",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.openai.com wss://generativelanguage.googleapis.com",
        "worker-src": "'self' blob:",
        "frame-src": "http://dm-preview.localhost dm-preview:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": false,
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "DumbManager Rust",
    "copyright": "DumbManager Rust",
    "category": "DeveloperTool",
    "shortDescription": "Isolated native DumbManager companion",
    "longDescription": "DumbManager Rust is a separate native Windows app with its own data folder. It does not read, change or launch the original DumbManager or DumbAPI.",
    "icon": [
      "../assets/icons/32x32.png",
      "../assets/icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../assets/icons/icon.ico",
        "displayLanguageSelector": false
      },
      "wix": {
        "upgradeCode": "f5209b1c-d7e5-4136-9b20-927ff6beb72a"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0QjVFQkIyODg3QkE3MzEKUldReHAzdUlzdXUxSk1aakpUV29JRExNZzl2OVpGczRUQ3J1cTMrRGROb3NoR0N3ZnlJWDRQaDcK",
      "endpoints": [
        "https://github.com/ChickenStrxps/dumbmanager-rust/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
