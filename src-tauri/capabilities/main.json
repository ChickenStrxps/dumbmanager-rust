{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Bundled main UI may call native commands and receive shortcut events. No remote origins or other plugin APIs.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-snapshot",
    "allow-itch-list",
    "allow-itch-save",
    "allow-itch-transition",
    "allow-settings-get",
    "allow-settings-save",
    "allow-card-export",
    "allow-open-export-folder",
    "allow-choose-path",
    "allow-legacy-api"
  ]
}
